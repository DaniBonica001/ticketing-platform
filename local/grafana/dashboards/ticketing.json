    {
      "type": "timeseries",
      "title": "Order processing duration",
      "id": 11,
      "description": "Quantiles need percentile histograms enabled for the timer; mean always works. Unit assumes Micrometer's milliseconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"ticketing_order_processing_duration(_milliseconds|_seconds)?_bucket\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"ticketing_order_processing_duration(_milliseconds|_seconds)?_bucket\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"ticketing_order_processing_duration(_milliseconds|_seconds)?_bucket\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate({__name__=~\"ticketing_order_processing_duration(_milliseconds|_seconds)?_sum\"}[$__rate_interval])) / sum(rate({__name__=~\"ticketing_order_processing_duration(_milliseconds|_seconds)?_count\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "refId": "D"
        }
      ]
    },
