{
  "info": {
    "name": "Ticketing API",
    "description": "Main flows of the ticketing platform. Run `make up` first, then paste fresh tokens from `make token-user` and `make token-admin` into the `userToken` / `adminToken` variables of the 'Ticketing local' environment (tokens last 15 minutes).\n\nRun the folders in order: 1 → 5. Requests store the ids they create (eventId, orderId, idempotencyKey) in collection variables, and each one has tests asserting the expected status.\n\nThe Server-Sent Events stream is not part of this collection (it stays open for 5 minutes and blocks runners); try it with: curl -N http://127.0.0.1:8090/api/v1/events/<eventId>/availability/stream",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "eventEtag",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Events",
      "item": [
        {
          "name": "Create event (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('eventId', body.eventId);",
                  "pm.collectionVariables.set('eventEtag', pm.response.headers.get('ETag'));",
                  "pm.test('all tickets AVAILABLE', () => pm.expect(body.availability.available).to.eql(body.capacity));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karol G - Tropicoqueta Tour\",\n  \"eventDate\": \"2026-12-20T20:00:00-05:00\",\n  \"venue\": \"Estadio Atanasio Girardot\",\n  \"capacity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            }
          }
        },
        {
          "name": "List events (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has items', () => pm.expect(pm.response.json().items).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/events?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get event (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('eventEtag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "Availability (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('counters add up to capacity', () => pm.expect(a.available + a.reserved + a.pendingConfirmation + a.sold + a.complimentary).to.eql(a.capacity));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "availability"
              ]
            }
          }
        },
        {
          "name": "Update event with stale If-Match → 412",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('412 VERSION_CONFLICT', () => { pm.response.to.have.status(412); pm.expect(pm.response.json().code).to.eql('VERSION_CONFLICT'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "\"999\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karol G - new date\",\n  \"eventDate\": \"2026-12-21T20:00:00-05:00\",\n  \"venue\": \"Estadio Atanasio Girardot\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "Update event with current If-Match → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('eventEtag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "{{eventEtag}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karol G - new date\",\n  \"eventDate\": \"2026-12-21T20:00:00-05:00\",\n  \"venue\": \"Estadio Atanasio Girardot\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Purchase",
      "item": [
        {
          "name": "Place order (new Idempotency-Key) → 202 QUEUED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('orderId', body.orderId);",
                  "pm.test('QUEUED', () => pm.expect(body.status).to.eql('QUEUED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Retry with the same Idempotency-Key → same order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 with the same orderId', () => { pm.response.to.have.status(202); pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get('orderId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Same key, different payload → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 IDEMPOTENCY_KEY_REUSED', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_REUSED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Order status → RESERVED (wait ~1 s after placing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('RESERVED with expiresAt', () => { const o = pm.response.json(); pm.expect(o.status).to.eql('RESERVED'); pm.expect(o.expiresAt).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Confirm payment → 202 PENDING_CONFIRMATION",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 PENDING_CONFIRMATION', () => { pm.response.to.have.status(202); pm.expect(pm.response.json().status).to.eql('PENDING_CONFIRMATION'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentReference\": \"PAY-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "confirm"
              ]
            },
            "description": "Simulated payment gateway: references starting with DECLINED- are rejected, UNAVAILABLE- simulates an outage and SLOW- a timeout (circuit breaker)."
          }
        },
        {
          "name": "Order status → SOLD (wait ~1 s after confirming)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SOLD', () => pm.expect(pm.response.json().status).to.eql('SOLD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Order history (audit trail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('4 transitions ending in SOLD', () => { const h = pm.response.json(); pm.expect(h.map(t => t.toStatus)).to.eql(['QUEUED', 'RESERVED', 'PENDING_CONFIRMATION', 'SOLD']); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "history"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Sold out and declined payment",
      "item": [
        {
          "name": "Place order bigger than the remaining stock",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted (validated asynchronously)', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('orderId', pm.response.json().orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Order status → REJECTED / SOLD_OUT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('REJECTED SOLD_OUT', () => { const o = pm.response.json(); pm.expect(o.status).to.eql('REJECTED'); pm.expect(o.reason).to.eql('SOLD_OUT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Place order of 1 ticket (for the declined payment)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('orderId', pm.response.json().orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Confirm with DECLINED- reference",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentReference\": \"DECLINED-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "Order status → REJECTED / PAYMENT_DECLINED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('REJECTED PAYMENT_DECLINED', () => { const o = pm.response.json(); pm.expect(o.status).to.eql('REJECTED'); pm.expect(o.reason).to.eql('PAYMENT_DECLINED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Complimentary (admin)",
      "item": [
        {
          "name": "Issue 1 complimentary ticket → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 COMPLIMENTARY', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('COMPLIMENTARY'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"recipientUserId\": \"vip-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/complimentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "complimentary"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Security checks",
      "item": [
        {
          "name": "Place order without token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 UNAUTHORIZED', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Create event with a user token → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 FORBIDDEN', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hack\",\n  \"eventDate\": \"2026-12-20T20:00:00-05:00\",\n  \"venue\": \"x\",\n  \"capacity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            }
          }
        },
        {
          "name": "Invalid payload → 400 with field errors",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 VALIDATION_ERROR', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
