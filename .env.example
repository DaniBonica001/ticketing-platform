# Local overrides for docker-compose.yml and scripts/. Copy to .env (git-ignored) only if you need to
# change something: every variable has a working default, so the stack runs without a .env file.
# DUMMY VALUES ONLY. Never put real credentials here.
#
# Resource names (tables, queues, secret, Lambda, rule) are fixed by docs/design/conventions.md and
# are intentionally not configurable.

# --- AWS / LocalStack (dummy credentials, LocalStack accepts anything) -----------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Set to 1 for verbose LocalStack logs.
LOCALSTACK_DEBUG=0

# --- aws-bootstrap -----------------------------------------------------------------------------------
# Payment gateway API key stored in Secrets Manager as {"apiKey": "..."} on first bootstrap.
# Leave empty to generate a random local value. Allowed: [A-Za-z0-9._~-]{8,128}.
PAYMENT_GATEWAY_API_KEY=
# SSE-KMS with a local customer managed key (alias/ticketing-local) for tables, queues and the secret.
ENABLE_KMS=true
# true skips the Lambda, its IAM role and the EventBridge schedule (troubleshooting only).
SKIP_LAMBDA=false

# --- expirer-builder ---------------------------------------------------------------------------------
# Source of the Lambda zip. The default builds the real expirer with ./gradlew buildLambdaZip.
# ./local/expirer-builder/placeholder builds a stub handler (validates the environment without the micro).
EXPIRER_SRC_DIR=./ms-reservation-expirer

# --- JWT (simulated IdP, ADR-0006) -------------------------------------------------------------------
JWT_ISSUER=https://auth.ticketing.local
JWT_AUDIENCE=ticketing-api
# Public key mounted into ms-ticketing-api at /run/secrets/jwt-public.pem.
JWT_PUBLIC_KEY_FILE=./local/secrets/jwt-public.pem
# Private key used by scripts/issue-token.sh (never mounted into any container).
JWT_PRIVATE_KEY_FILE=./local/secrets/jwt-private.pem

# --- Grafana (http://127.0.0.1:3300, anonymous read access) ------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-local
